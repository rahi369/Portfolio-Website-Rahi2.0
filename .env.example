# GEMINI_API_KEY: Required for Gemini AI API calls (if server-side AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted (used for sitemap.xml and robots.txt).
APP_URL="MY_APP_URL"

# Firebase Web SDK Configuration (Existing Project: portfolio-website-for-rahi)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="portfolio-website-for-rahi"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Optional Cloudinary Unsigned Upload Configuration (fallback/external CDN hosting)
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# Optional Private Admin Entry Route (defaults to /rahi-369-studio)
VITE_ADMIN_ENTRY_PATH="/rahi-369-studio"
